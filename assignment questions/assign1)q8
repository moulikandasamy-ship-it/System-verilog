//9. Declare a static array:
//logic [7:0] arr[8];
//Use a for loop to initialize each element with the value i + 8'h10. Display all elements.

module arr;

  logic [7:0] arr[8];
  int i;

  initial begin
    foreach (arr[i]) begin
      arr[i] = i + 8'h10;
    end

    foreach (arr[i]) begin
      $display("arr[%0d] = %0h", i, arr[i]);
    end
  end

endmodule
