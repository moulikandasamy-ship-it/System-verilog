//11. Declare two static arrays of type int with size [5].
//Initialize the first array and copy elements to the second array using a for loop.
//Display both arrays.
 

module two_array;

  int a[5];
  int b[5];
  int i;

  initial begin
    a = '{2, 3, 4, 5, 6};
    for (i = 0; i < 5; i++) begin
      b[i] = a[i];
    end
    for (i = 0; i < 5; i++) begin
      $display("a[%0d] = %0d , b[%0d] = %0d", i, a[i], i, b[i]);
    end
  end

endmodule
