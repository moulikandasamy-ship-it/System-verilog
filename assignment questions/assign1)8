//8. Declare a 2D static array of type bit with size [4][8].Initialize all elements in row index 1 to 8'hFF
//using a loop and display each element using $display.

module twoD;
  logic [8]arr[4];
  
  initial begin
    arr[1]=8'hFF;
    
    foreach(arr[i])begin
      $display("all elements are arr[%0d]=%0h",i,arr[i]);
    end
  end
endmodule
