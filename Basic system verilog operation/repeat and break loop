module repeat_example;
  int array[5] = '{100, 200, 300, 400, 500};
  int i;
  initial begin
    repeat ($size(array)) begin
      $display("array[%0d] = %0d", i, array[i]);
      i++;
    end
    i=0;
    repeat(3)begin
    if(i==2)begin
    $display("\tCalling break,"); 
     break;
    end
      $display("silicon craft");
    i++;
  end
  end
endmodule
