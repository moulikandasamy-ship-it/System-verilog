class student;
  string name;
  int mark;
  real gpa;
  function new(string name,int mark);
    this.name = name;
    this.mark = mark;
    gpa = (mark / 10.0);
  endfunction
  
  function display();
    $display("Name = %0s Mark = %0d ",name,mark);
    $display("GPA = %0.2f",gpa);
    if(mark > 60)
      $display("PASS");
    else
      $display("FAIL");
  endfunction
  
  
endclass

module marks;
  student s1,s2,s3;
  initial begin
    s1 =new("A",93);
    s1.display();
    s2 =new("B",54);
    s2.display();
    s3 =new("C",49);
    s3.display(); 
  end
endmodule
    
