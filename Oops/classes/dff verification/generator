class generator;
  mailbox g2d;
  mailbox g2r;
  
  function new(mailbox g2d,mailbox g2r);
    this.g2d = g2d;
    this.g2r = g2r;
  endfunction
  
  task run();
    transaction tr;
    
    repeat(20)begin
    tr = new();
      assert(tr.randomize());
      $display("GENERATOR : d = %0d",tr.d);
      g2d.put(tr);
      g2r.put(tr);
      
    end
  endtask
endclass
