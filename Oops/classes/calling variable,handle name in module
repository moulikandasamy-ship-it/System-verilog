class Packet;

  bit [31:0] addr;
  bit [31:0] data;

  function new();
    addr = 32'hfade_cafe;
    data = 32'hfade_cafa;
  endfunction

  function void display();
    $display("addr = 0x%0h", addr);
  endfunction

  function void show(int d);
    $display("d is = 0x%0h", d);
  endfunction

endclass


module tb;

  int d;
  Packet c, pkt;

  initial begin
    pkt = new();   
    c   = new();   

    c = pkt;       

    d = pkt.data;

    pkt.display();
    pkt.show(d);

  end

endmodule
