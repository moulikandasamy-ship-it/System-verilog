class generator;

   transaction tr;

   mailbox #(transaction) gen2drv;

   function new(mailbox #(transaction) gen2drv);
      this.gen2drv = gen2drv;
   endfunction

   task run();

      for(int i=0; i<8; i++) begin

         tr = new();

         tr.a   = i[2];
         tr.b   = i[1];
         tr.cin = i[0];

         gen2drv.put(tr);

         tr.display("GENERATOR");

      end

   endtask

endclass
